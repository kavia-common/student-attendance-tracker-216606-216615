# Backend (Compose) environment for PostgreSQL and Node API stack
# Copy to .env and adjust as needed.

# Postgres discrete vars
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=attendance_pass

# Optionally provide a full DATABASE_URL instead of discrete vars
# DATABASE_URL=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db

# API server
PORT=8080

# Auth
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=1d

# CORS (comma-separated origins; * allowed in dev)
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
