# PUBLIC_INTERFACE
# Backend environment example for database connectivity.
# Copy to .env and adjust values as needed.

# Individual connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=attendance_pass

# Full connection URL (preferred by many ORMs/drivers)
# Note: Ensure special characters in password are URL-encoded if necessary.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
