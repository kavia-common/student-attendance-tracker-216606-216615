# Server
PORT=8080
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Database (use either DATABASE_URL or discrete DB_* values)
DATABASE_URL=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db

DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=attendance_pass

# Optional: site URL for email redirects (if implementing email flows later)
SITE_URL=http://localhost:8080
