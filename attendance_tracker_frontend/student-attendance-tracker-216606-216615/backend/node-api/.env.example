# Server
PORT=8080
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# JWT
JWT_SECRET=please_change_me_in_prod
JWT_EXPIRES_IN=1d

# Database (prefer DATABASE_URL; otherwise use discrete fields)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=attendance_pass

# Example consolidated URL (uncomment to use)
# DATABASE_URL=postgresql://attendance_user:attendance_pass@postgres:5432/attendance_db
