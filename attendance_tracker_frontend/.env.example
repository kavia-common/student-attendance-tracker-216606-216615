# Environment variables for Attendance Tracker (Flutter)
# Copy this file to `.env` at the project root (same folder as pubspec.yaml) and adjust as needed.

# Base URL for REST API calls (no trailing slash)
API_BASE_URL=http://localhost:8000

# WebSocket endpoint for real-time updates
WEBSOCKET_URL=ws://localhost:8000/ws

# Toggle to use local database for attendance storage (true/false or 1/0)
FEATURE_USE_LOCAL_DB=true

# SQLite database filename when using local DB
ATTENDANCE_DB_NAME=attendance.db
